@article{li2025sfw,
  title        = {Efficient Variants of {W}asserstein Distance in Hyperbolic Space via Space-Filling Curve Projection},
  author       = {Li, Tao and Meng, Cheng and Xu, Hongteng and Zhu, Jun},
  annotation   = {Authors are listed in alphabetical order.}
  journal      = {IEEE Transactions on Neural Networks and Learning Systems},
  year         = {2025},
  volume       = {36},
  number       = {9},
  pages        = {16814--16824},
  doi          = {10.1109/TNNLS.2025.3551275},
  url          = {https://doi.org/10.1109/TNNLS.2025.3551275},
  html         = {https://doi.org/10.1109/TNNLS.2025.3551275},
  abbr         = {TNNLS},
  bibtex_show  = {true},
  selected     = {true},
  abstract     = {We propose efficient variants of Wasserstein distance for probability distributions in hyperbolic space via space-filling curve projection. The method yields a closed-form coupling after projection, admits metric and statistical guarantees for bounded-support measures, and includes geodesic and horospherical variants to mitigate the curse of dimensionality.}
}

@article{zhu2023eeggcn,
  title        = {Graph Convolutional Neural Network with Multi-Scale Attention Mechanism for {EEG}-Based Motion Imagery Classification},
  author       = {Zhu, Jun and Liu, Qingshan and Xu, Chentao},
  journal      = {International Journal of Pattern Recognition and Artificial Intelligence},
  year         = {2023},
  volume       = {37},
  number       = {14},
  pages        = {2354020:1--2354020:19},
  doi          = {10.1142/S0218001423540204},
  url          = {https://doi.org/10.1142/S0218001423540204},
  html         = {https://doi.org/10.1142/S0218001423540204},
  abbr         = {IJPRAI},
  bibtex_show  = {true},
  selected     = {true},
  abstract     = {This work studies EEG-based motion imagery classification with a graph convolutional neural network that explicitly models correlations among EEG electrodes. EEG signals are transformed into graph data using phase lag index together with time-domain and frequency-domain features, and a multi-scale attention mechanism is introduced to improve classification accuracy.}
}

